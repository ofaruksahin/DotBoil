<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Title>DotBoil.Caching</Title>
		<Authors>Ömer Faruk Şahin</Authors>
		<Description>The DotBoil.Caching package is built on the DotBoil project. It simplifies Redis cache integration.</Description>
		<PackageProjectUrl>https://github.com/ofaruksahin/DotBoil</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ofaruksahin/DotBoil</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="StackExchange.Redis" Version="2.8.16" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DotBoil\DotBoil.csproj" />
	</ItemGroup>

</Project>
