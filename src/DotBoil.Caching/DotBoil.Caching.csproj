<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Title>DotBoil.Caching</Title>
		<Authors>Ömer Faruk Şahin</Authors>
		<Description>Redis-backed distributed caching for DotBoil applications. Provides IDistributedCache integration and a high-level ICacheService with typed get/set/invalidate operations and configurable expiry.</Description>
		<PackageProjectUrl>https://github.com/ofaruksahin/DotBoil</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ofaruksahin/DotBoil</RepositoryUrl>
		<Version>1.1.0</Version>
		<PackageIcon>dotboil.png</PackageIcon>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="StackExchange.Redis" Version="2.10.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DotBoil\DotBoil.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\icons\dotboil.png">
	    <Pack>True</Pack>
	    <PackagePath></PackagePath>
	    <Link>dotboil.png</Link>
	  </None>
	</ItemGroup>

</Project>
