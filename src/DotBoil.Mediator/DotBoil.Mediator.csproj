<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>DotBoil.Mediator</Title>
        <Authors>Ömer Faruk Şahin</Authors>
        <Description>MediatR integration for DotBoil applications. Registers the mediator pipeline and auto-discovers request handlers and pipeline behaviors across all loaded assemblies at startup.</Description>
        <PackageProjectUrl>https://github.com/ofaruksahin/DotBoil</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ofaruksahin/DotBoil</RepositoryUrl>
        <PackageIcon>dotboil.png</PackageIcon>
        <Version>1.9.3</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MediatR" Version="14.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DotBoil\DotBoil.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\icons\dotboil.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
        <Link>dotboil.png</Link>
      </None>
    </ItemGroup>

</Project>
