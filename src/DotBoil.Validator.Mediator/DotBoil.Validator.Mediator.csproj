<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>DotBoil.Validator.Mediator</Title>
        <Authors>Ömer Faruk Şahin</Authors>
        <Description>MediatR pipeline behavior that runs FluentValidation validators on every incoming request. Returns structured validation errors before handlers are invoked, keeping handler code free of manual validation logic.</Description>
        <PackageProjectUrl>https://github.com/ofaruksahin/DotBoil</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ofaruksahin/DotBoil</RepositoryUrl>
        <PackageIcon>dotboil.png</PackageIcon>
        <Version>1.9.4</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\DotBoil.Mediator\DotBoil.Mediator.csproj" />
      <ProjectReference Include="..\DotBoil.Validator\DotBoil.Validator.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\icons\dotboil.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
        <Link>dotboil.png</Link>
      </None>
    </ItemGroup>

</Project>
