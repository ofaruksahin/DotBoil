<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8db8ea2c-51b6-4b38-86f1-664d74dea692</UserSecretsId>
	  <Nullable>disable</Nullable>
	  <Title>DotBoil</Title>
	  <Authors>Ömer Faruk Şahin</Authors>
	  <Description>The DotBoil package is the heart of the project. All modules are developed with reference to the DotBoil package. It contains the necessary classes for creating modules, the installers required for loading these packages, and the fundamental DotBoil modules.</Description>
	  <PackageProjectUrl>https://github.com/ofaruksahin/DotBoil</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/ofaruksahin/DotBoil</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.App" Version="2.2.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0-preview.6.24327.7" />
  </ItemGroup>

</Project>
