@implements IDisposable
@if (Current.IsVisible)
{
    <MudTextField T="string"
                  bind-Value="Current.Value"
                  Label="@Current.Label"
                  HelperText="@Current.HelperText"
                  Variant="Variant.Outlined"
                  Disabled="@(!Current.IsEnabled)"
                  ValueChanged="text => ValueChanged(text)"></MudTextField>

    if (Current.HasValidationError)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">@Current.ValidationMessage</MudText>
    }
}

@code
{
    [Parameter] public TextField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Current.DependsOnHandler == null)
            Current.DependsOnHandler += OnDepend;

        if (!Context.DesignerMode)
            ComponentRuleEvaluator.Apply(Current, Context);
        
        base.OnAfterRender(firstRender);
    }

    private async Task OnDepend(BaseComponent component, EventArgs args)
    {
        if (Context.DesignerMode)
            return;

        ComponentRuleEvaluator.Apply(Current, Context);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ValueChanged(string text)
    {
        Current.Value = text;

        await Context.OnDepends(Current);
        await OnDepend(Current, EventArgs.Empty);
    }

    public void Dispose()
    {
        if (Current.DependsOnHandler != null)
            Current.DependsOnHandler -= OnDepend;
    }
}
