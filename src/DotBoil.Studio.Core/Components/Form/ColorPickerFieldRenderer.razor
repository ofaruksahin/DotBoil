@using MudBlazor.Utilities
@implements IDisposable

<MudColorPicker Value="Current.Value"
                Label="@Current.Label"
                HelperText="@Current.HelperText"
                Variant="Variant.Outlined"
                PickerVariant="PickerVariant.Inline"
                ValueChanged="val => ColorChanged(val)"/>

@code
{
    [Parameter] public ColorPickerField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }
    [Parameter] public EventCallback<ColorPickerField> ColorPicked { get; set; }

    private BaseComponent? _initializedFor;

    protected override void OnAfterRender(bool firstRender)
    {
        if (ReferenceEquals(_initializedFor, Current))
        {
            base.OnAfterRender(firstRender);
            return;
        }

        if (_initializedFor is not null)
            ComponentRuleRenderHelper.Dispose(_initializedFor, Context, OnDepends);

        _initializedFor = Current;
        ComponentRuleRenderHelper.Initialize(Current, Context, OnDepends);
        base.OnAfterRender(firstRender);
    }


    private async Task ColorChanged(MudColor color)
    {
        Current.Value = color;
        
        if (ColorPicked.HasDelegate)
            await ColorPicked.InvokeAsync(Current);

        await Context.OnDepends(Current);
        await OnDepends(Current, EventArgs.Empty);
    }

    private async Task OnDepends(BaseComponent component, EventArgs args)
    {
        ComponentRuleRenderHelper.ApplyOnDepends(Current, Context);
    }

    public void Dispose()
    {
        ComponentRuleRenderHelper.Dispose(Current, Context, OnDepends);
    }
}