@using MudBlazor.Utilities
@implements IDisposable

<MudColorPicker bind-Value="Current.Value"
                Label="@Current.Label"
                HelperText="@Current.HelperText"
                Variant="Variant.Outlined"
                PickerVariant="PickerVariant.Inline"
                ValueChanged="val => ColorChanged(val)"/>

@code
{
    [Parameter] public ColorPickerField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }
    [Parameter] public EventCallback<ColorPickerField> ColorPicked { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Current.DependsOnHandler == null)
            Current.DependsOnHandler += OnDepends;
        
        base.OnAfterRender(firstRender);
    }


    private async Task ColorChanged(MudColor color)
    {
        Current.Value = color;
        
        if (ColorPicked.HasDelegate)
            await ColorPicked.InvokeAsync(Current);

        await Context.OnDepends(Current);
    }

    private async Task OnDepends(BaseComponent component, EventArgs args)
    {
    }

    public void Dispose()
    {
        if (Current.DependsOnHandler != null)
            Current.DependsOnHandler -= OnDepends;
    }
}