@if (Context.DesignerMode)
{
    <MudCheckBox T="bool" bind-Value="Current.Value" Label="@Current.Label" CheckedIcon="@Current.CheckedIcon.Value" UncheckedIcon="@Current.UncheckedIcon.Value" ValueChanged="ValueChanged">
    </MudCheckBox>
}
else
{
    <MudCheckBox T="bool" @bind-Value="Current.Value" Label="@Current.Label" CheckedIcon="@Current.CheckedIcon.Value" UncheckedIcon="@Current.UncheckedIcon.Value">
    </MudCheckBox>   
}

@code {
    [Parameter] public CheckBoxField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }

    private async Task ValueChanged(bool val)
    {
        Current.Value = val;
        
        if (Context.DesignerMode)
        {
            if (Context.OnFieldSelected.HasDelegate)
                await Context.OnFieldSelected.InvokeAsync(Current);
        }
    }
}