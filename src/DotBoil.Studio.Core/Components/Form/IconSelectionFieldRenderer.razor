@inject IDialogService DialogService;
@implements IDisposable;

@if (Current.IsVisible)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenIconDialog" Disabled="@(!Current.IsEnabled)" class="mb-3">
        <MudIcon Icon="@Current.Value" Size="Size.Large"></MudIcon>
    </MudButton>

    if (Current.HasValidationError)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">@Current.ValidationMessage</MudText>
    }
}

@code {
    [Parameter] public IconSelectionField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }
    [Parameter] public EventCallback<IconSelectionField> IconSelected { get; set; }

    private BaseComponent? _initializedFor;

    protected override void OnAfterRender(bool firstRender)
    {
        if (ReferenceEquals(_initializedFor, Current))
        {
            base.OnAfterRender(firstRender);
            return;
        }

        if (_initializedFor is not null)
            ComponentRuleRenderHelper.Dispose(_initializedFor, Context, OnDepends);

        _initializedFor = Current;
        ComponentRuleRenderHelper.Initialize(Current, Context, OnDepends);
        base.OnAfterRender(firstRender);
    }

    private async Task OpenIconDialog()
    {
        if (!Current.IsEnabled)
            return;

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = true
        };

        var dialog = DialogService.ShowAsync<IconSelectionDialog>(IconSelectionDialog.DialogTitle, options);
        var dialogReference = await dialog;
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            var icon = (string)result.Data;
            Current.Value = icon;

            if (IconSelected.HasDelegate)
                await IconSelected.InvokeAsync(Current);

            await Context.OnDepends(Current);
        }
    }

    private async Task OnDepends(BaseComponent baseComponent, EventArgs args)
    {
        ComponentRuleRenderHelper.ApplyOnDepends(Current, Context);
        if (Context.DesignerMode)
            return;

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ComponentRuleRenderHelper.Dispose(Current, Context, OnDepends);
    }
}