@inject IDialogService DialogService;
@implements IDisposable;

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenIconDialog" class="mb-3">
    <MudIcon Icon="@Current.Value" Size="Size.Large"></MudIcon>
</MudButton>

@code {
    [Parameter] public IconSelectionField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }
    [Parameter] public EventCallback<IconSelectionField> IconSelected { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Current.DependsOnHandler != null)
            Current.DependsOnHandler += OnDepends;

        base.OnAfterRender(firstRender);
    }

    private async Task OpenIconDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = true
        };

        var dialog = DialogService.ShowAsync<IconSelectionDialog>(IconSelectionDialog.DialogTitle, options);
        var dialogReference = await dialog;
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            var icon = (string)result.Data;
            Current.Value = icon;

            if (IconSelected.HasDelegate)
                await IconSelected.InvokeAsync(Current);

            await Context.OnDepends(Current);
        }
    }

    private async Task OnDepends(BaseComponent baseComponent, EventArgs args)
    {
    }

    public void Dispose()
    {
        if (Current.DependsOnHandler != null)
            Current.DependsOnHandler -= OnDepends;
    }
}