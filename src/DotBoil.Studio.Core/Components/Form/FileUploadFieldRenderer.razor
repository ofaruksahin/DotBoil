@implements IDisposable;
@if (Current != null && Current.IsVisible)
{
    if (Context.DesignerMode)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Current.UploadIcon.Value"
                   Disabled="@(!Current.IsEnabled)"
                   OnClick="HandleClick">
            @Current.Text
        </MudButton>
    }
    else
    {
        if (Current.Multiple)
        {
            <MudFileUpload 
                T="IReadOnlyList<IBrowserFile>" 
                FilesChanged="UploadFileMultiple" 
                MaximumFileCount="Current.MaximumFileCount"
                MaxFileSize="Current.MaximumFileSize">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Current.UploadIcon.Value"
                               Disabled="@(!Current.IsEnabled)">
                        @Current.Text
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        }
        else
        {
            <MudFileUpload 
                T="IBrowserFile" 
                FilesChanged="UploadFileSingle"
                MaximumFileCount="Current.MaximumFileCount"
                MaxFileSize="Current.MaximumFileSize">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Current.UploadIcon.Value"
                               Disabled="@(!Current.IsEnabled)">
                        @Current.Text
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        }   
    }

    if (Current.HasValidationError)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">@Current.ValidationMessage</MudText>
    }
}

@code{
    [Parameter] public FileUploadField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Current.DependsOnHandler == null)
            Current.DependsOnHandler += OnDepends;

        if (!Context.DesignerMode)
            ComponentRuleEvaluator.Apply(Current, Context);
        
        base.OnAfterRender(firstRender);
    }

    private async Task UploadFileMultiple(IReadOnlyList<IBrowserFile> files)
    {
        if (!Current.IsEnabled)
            return;

        Current.Value.Clear();

        foreach (var file in files)
            Current.Value.Add(file);

        await SelectedFileChanged();
    }

    private async Task UploadFileSingle(IBrowserFile file)
    {
        if (!Current.IsEnabled)
            return;

        Current.Value.Clear();
        Current.Value.Add(file);

        await SelectedFileChanged();
    }

    private async Task HandleClick()
    {
        if (Context is null)
            return;
        
        if (Context.OnFieldSelected.HasDelegate)
            await Context.OnFieldSelected.InvokeAsync(Current);
    }

    private async Task SelectedFileChanged()
    {
        await Context.OnDepends(Current);
        await OnDepends(Current, EventArgs.Empty);
    }

    private async Task OnDepends(BaseComponent baseComponent, EventArgs args)
    {
        if (Context.DesignerMode)
            return;

        ComponentRuleEvaluator.Apply(Current, Context);
        await InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        if (Current.DependsOnHandler != null)
            Current.DependsOnHandler -= OnDepends;
    }
}