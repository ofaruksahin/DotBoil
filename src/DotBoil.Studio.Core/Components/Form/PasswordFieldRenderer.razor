@implements IDisposable
@if (Current.IsVisible)
{
    <MudTextField T="string"
                  Value="@Current.Value"
                  Label="@Current.Label"
                  HelperText="@Current.HelperText"
                  Variant="Variant.Outlined"
                  InputType="@(showPassword ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End"
                  AdornmentIcon="@(showPassword ? Current.ShowPasswordIcon.Value : Current.HidePasswordIcon.Value)"
                  OnAdornmentClick="TogglePassword"
                  Disabled="@(!Current.IsEnabled)"
                  ValueChanged="text => ValueChanged(text)"/>

    if (Current.HasValidationError)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">@Current.ValidationMessage</MudText>
    }
}

@code
{
    [Parameter] public PasswordField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }

    private bool showPassword;
    private BaseComponent? _initializedFor;

    protected override void OnAfterRender(bool firstRender)
    {
        if (ReferenceEquals(_initializedFor, Current))
        {
            base.OnAfterRender(firstRender);
            return;
        }

        if (_initializedFor is not null)
            ComponentRuleRenderHelper.Dispose(_initializedFor, Context, OnDepend);

        _initializedFor = Current;
        ComponentRuleRenderHelper.Initialize(Current, Context, OnDepend);
        base.OnAfterRender(firstRender);
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task ValueChanged(string text)
    {
        Current.Value = text;

        await Context.OnDepends(Current);
        await OnDepend(Current, EventArgs.Empty);
    }

    private async Task OnDepend(BaseComponent component, EventArgs args)
    {
        ComponentRuleRenderHelper.ApplyOnDepends(Current, Context);
        if (Context.DesignerMode)
            return;

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ComponentRuleRenderHelper.Dispose(Current, Context, OnDepend);
    }
}