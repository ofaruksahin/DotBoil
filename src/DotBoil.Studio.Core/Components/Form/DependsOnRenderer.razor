<style>
    .dor-wrap { display: flex; flex-direction: column; gap: 10px; }

    .dor-chips {
        display: flex; flex-wrap: wrap; gap: 6px;
        min-height: 36px; padding: 8px 10px;
        background: #f8fafc; border: 1px solid #e2e8f0;
        border-radius: 10px;
    }
    .dor-empty {
        font-size: .72rem; color: #94a3b8;
        display: flex; align-items: center; gap: 5px;
    }
</style>

<div class="dor-wrap">

    <MudTextField T="string"
                  @bind-Value="Value"
                  Label="Element Id ekle"
                  Placeholder="Bağımlı olunacak alanın Id'sini girin"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Rounded.AddCircleOutline"
                  OnAdornmentClick="AddDependsOn"
                  OnKeyDown="OnKeyDown" />

    <div class="dor-chips">
        @if (Current != null && Current.Any())
        {
            @foreach (var item in Current)
            {
                <MudChip T="string"
                         Text="@item"
                         Color="Color.Primary"
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         CloseIcon="@Icons.Material.Rounded.Close"
                         OnClose="() => RemoveDependsOn(item)" />
            }
        }
        else
        {
            <span class="dor-empty">
                <MudIcon Icon="@Icons.Material.Rounded.LinkOff" Size="Size.Small" />
                Henüz bağımlılık tanımlanmadı
            </span>
        }
    </div>

</div>

@code {
    [Parameter] public List<string> Current { get; set; } = new();
    [Parameter] public BaseComponent CurrentComponent { get; set; }

    private string Value { get; set; } = string.Empty;

    private void AddDependsOn()
    {
        var trimmed = Value?.Trim();
        if (string.IsNullOrEmpty(trimmed) || Current.Contains(trimmed))
        {
            Value = string.Empty;
            return;
        }

        Current.Add(trimmed);
        CurrentComponent.DependsOn = Current;
        Value = string.Empty;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddDependsOn();
    }

    private void RemoveDependsOn(string item)
    {
        Current.RemoveAll(c => c == item);
        CurrentComponent.DependsOn = Current;
    }
}