@implements IDisposable;
@if (Current.IsVisible)
{
    <MudTextField T="string"
                  Label="@Current.Label"
                  HelperText="@Current.HelperText"
                  bind-Value="Current.Value"
                  InputType="InputType.Email"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Current.Icon.Value"
                  Disabled="@(!Current.IsEnabled)"
                  ValueChanged="email => EmailChanged(email)"/>

    if (Current.HasValidationError)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">@Current.ValidationMessage</MudText>
    }
}

@code {
    [Parameter] public EmailField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        ComponentRuleRenderHelper.Initialize(Current, Context, OnDepends);
        
        base.OnAfterRender(firstRender);
    }

    private async Task EmailChanged(string email)
    {
        Current.Value = email;
        await Context.OnDepends(Current);
        await OnDepends(Current, EventArgs.Empty);
    }

    private async Task OnDepends(BaseComponent baseComponent, EventArgs args)
    {
        ComponentRuleRenderHelper.ApplyOnDepends(Current, Context);
        if (Context.DesignerMode)
            return;

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ComponentRuleRenderHelper.Dispose(Current, Context, OnDepends);
    }
}