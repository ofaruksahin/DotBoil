@inject IDialogService DialogService
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject JwtAuthService JwtAuthService
@inject IJSRuntime JS
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Reflection
@using System.Text.Json
@using System.Text.RegularExpressions
@using DotBoil.Studio.Core.Attributes
@using DotBoil.Studio.Core.Services
@using DotBoil.Studio.Core.ValueObjects
@using Microsoft.AspNetCore.WebUtilities

<style>
    .fcr-wrap {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        background: #fafbfd;
        transition: border-color .2s;
    }
    .fcr-wrap:hover { border-color: #94a3b8; }
    .fcr-wrap.fcr-selected { border-color: #6366f1; border-style: solid; }

    .fcr-header {
        display: flex; align-items: center; gap: 8px;
        padding: 8px 12px; border-radius: 10px 10px 0 0;
        background: linear-gradient(135deg, #f0f9ff, #ede9fe);
        border-bottom: 1px solid #e0e7ff; cursor: pointer;
        user-select: none;
    }
    .fcr-header-icon { color: #6366f1; }
    .fcr-header-title { font-size: .78rem; font-weight: 700; color: #0f172a; flex: 1; }
    .fcr-header-desc {
        font-size: .66rem; color: #64748b; margin-top: 1px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .fcr-header-url {
        font-size: .68rem; color: #64748b; font-family: monospace;
        background: #e2e8f0; padding: 1px 7px; border-radius: 6px;
        max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 0;
    }

    .fcr-body { padding: 12px; }

    .fcr-empty {
        display: flex; flex-direction: column; align-items: center;
        padding: 24px 16px; color: #94a3b8; gap: 6px;
    }
    .fcr-empty-icon { font-size: 32px !important; }
    .fcr-empty-text { font-size: .78rem; font-weight: 500; }

    .fcr-footer {
        padding: 8px 12px; border-top: 1px solid #f1f5f9;
        display: flex; justify-content: flex-end;
        border-radius: 0 0 10px 10px;
    }
</style>

@if (Context.DesignerMode)
{
    <div class="fcr-wrap @(_isSelected ? "fcr-selected" : "")">

        <!-- Header — tıklanınca formu seçer -->
        <div class="fcr-header" @onclick="SelectForm" @onclick:stopPropagation="true">
            <MudIcon Icon="@Icons.Material.Rounded.DynamicForm" Size="Size.Small" Class="fcr-header-icon" />
            <div style="flex:1; min-width:0;">
                <div class="fcr-header-title">
                    @(string.IsNullOrWhiteSpace(Form.Name) ? Form.Title : Form.Name)
                </div>
                @if (!string.IsNullOrWhiteSpace(Form.Description))
                {
                    <div class="fcr-header-desc">@Form.Description</div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Form.ActionUrl))
            {
                <span class="fcr-header-url">@Form.HttpMethod @Form.ActionUrl</span>
            }
        </div>

        <!-- Children -->
        <div class="fcr-body" @onclick:stopPropagation="true">
            @if (Form.Children.Any())
            {
                <ComponentRenderer FormFields="Form.Children"
                                   DesignerMode="true"
                                   OnFieldSelected="Context.OnFieldSelected"
                                   OnFieldDeleted="Context.OnFieldDeleted"
                                   OnFieldsReordered="StateHasChanged" />
            }
            else
            {
                <div class="fcr-empty" @onclick="SelectForm" @onclick:stopPropagation="true">
                    <MudIcon Icon="@Icons.Material.Rounded.AddBox" Class="fcr-empty-icon" />
                    <span class="fcr-empty-text">Forma bileşen eklemek için + butonuna tıklayın</span>
                </div>
            }
        </div>

        <!-- Footer — bileşen ekle -->
        <div class="fcr-footer" @onclick:stopPropagation="true">
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       StartIcon="@Icons.Material.Rounded.Add"
                       Color="Color.Primary"
                       OnClick="OpenAddFieldDialog">
                Bileşen Ekle
            </MudButton>
        </div>

    </div>
}
else
{
    <div>
        <ComponentRenderer FormFields="Form.Children" DesignerMode="false" OnFieldSelected="Context.OnFieldSelected" />

        @if (!string.IsNullOrWhiteSpace(_resultMessage))
        {
            <MudAlert Severity="@(_submitSuccess ? Severity.Success : Severity.Error)" Class="mt-3" Dense="true">
                @_resultMessage
            </MudAlert>
        }

        <div class="d-flex justify-end gap-3 mt-3">
            @if (Form.CancelButtonVisible)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@(string.IsNullOrWhiteSpace(Form.CancelButtonIcon?.Value) ? null : Form.CancelButtonIcon.Value)"
                           OnClick="NavigateBack">
                    @(string.IsNullOrWhiteSpace(Form.CancelButtonText) ? "Vazgeç" : Form.CancelButtonText)
                </MudButton>
            }
            @if (!string.IsNullOrWhiteSpace(Form.SubmitButtonText))
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@(string.IsNullOrWhiteSpace(Form.SubmitButtonIcon?.Value) ? null : Form.SubmitButtonIcon.Value)"
                           Disabled="_submitting"
                           OnClick="HandleSubmit">
                    @Form.SubmitButtonText
                </MudButton>
            }
        </div>
    </div>
}

@code {
    [Parameter] public BaseComponent Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }

    private FormComponent Form => (FormComponent)Current;
    private bool _isSelected;
    private bool _dataLoaded;
    private bool _submitting;
    private bool _submitSuccess;
    private string? _resultMessage;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _isSelected = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Context.DesignerMode || _dataLoaded || string.IsNullOrWhiteSpace(Form.LoadUrl))
            return;

        _dataLoaded = true;
        await LoadFormDataAsync();
    }

    private async Task LoadFormDataAsync()
    {
        var resolvedUrl = ResolveUrlParameters(Form.LoadUrl);

        var client = HttpClientFactory.CreateClient();
        if (!string.IsNullOrWhiteSpace(JwtAuthService.Token))
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", JwtAuthService.Token);

        HttpResponseMessage response;
        try
        {
            response = await client.GetAsync(resolvedUrl);
        }
        catch
        {
            return;
        }

        if (!response.IsSuccessStatusCode)
            return;

        string json;
        try
        {
            json = await response.Content.ReadAsStringAsync();
        }
        catch
        {
            return;
        }

        using var doc = JsonDocument.Parse(json);
        if (!doc.RootElement.TryGetProperty("Data", out var dataElement) &&
            !doc.RootElement.TryGetProperty("data", out dataElement))
            return;

        if (dataElement.ValueKind != JsonValueKind.Object)
            return;

        var data = new Dictionary<string, JsonElement>(StringComparer.OrdinalIgnoreCase);
        foreach (var prop in dataElement.EnumerateObject())
            data[prop.Name] = prop.Value;

        MapDataToComponents(data, Form.Children);
    }

    private string ResolveUrlParameters(string url)
    {
        if (!url.Contains('{'))
            return url;

        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        return Regex.Replace(url, @"\{(\w+)\}", match =>
        {
            var key = match.Groups[1].Value;
            return query.TryGetValue(key, out var val) ? val.ToString() : match.Value;
        });
    }

    private static void MapDataToComponents(Dictionary<string, JsonElement> data, List<BaseComponent> components)
    {
        foreach (var component in components)
        {
            var outputProp = component.GetType()
                .GetProperties()
                .FirstOrDefault(p => p.GetCustomAttribute<FieldOutputPropertyAttribute>() is not null);

            if (outputProp is not null &&
                !string.IsNullOrWhiteSpace(component.Id) &&
                data.TryGetValue(component.Id, out var jsonValue))
            {
                var converted = ConvertJsonElement(jsonValue, outputProp.PropertyType);
                outputProp.SetValue(component, converted);
            }

            if (component is ContainerComponent container && container.Children?.Count > 0)
                MapDataToComponents(data, container.Children);
        }
    }

    private static object? ConvertJsonElement(JsonElement element, Type targetType)
    {
        if (element.ValueKind == JsonValueKind.Null)
            return null;

        var underlying = Nullable.GetUnderlyingType(targetType) ?? targetType;

        if (underlying == typeof(string))
            return element.ValueKind == JsonValueKind.String ? element.GetString() : element.ToString();

        if (underlying == typeof(int))
            return element.TryGetInt32(out var i) ? i : default(int);

        if (underlying == typeof(long))
            return element.TryGetInt64(out var l) ? l : default(long);

        if (underlying == typeof(double))
            return element.TryGetDouble(out var d) ? d : default(double);

        if (underlying == typeof(decimal))
            return element.TryGetDecimal(out var dc) ? dc : default(decimal);

        if (underlying == typeof(bool))
            return element.ValueKind == JsonValueKind.True;

        if (underlying == typeof(DateTime))
            return element.TryGetDateTime(out var dt) ? dt : default(DateTime);

        return element.ToString();
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Form.ActionUrl))
            return;

        _submitting = true;
        _resultMessage = null;
        StateHasChanged();

        var formData = new Dictionary<string, object?>();
        CollectFormData(formData, Form.Children);

        var client = HttpClientFactory.CreateClient();
        if (!string.IsNullOrWhiteSpace(JwtAuthService.Token))
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", JwtAuthService.Token);

        HttpResponseMessage response;
        try
        {
            var content = JsonContent.Create(formData);
            response = Form.HttpMethod.ToUpperInvariant() switch
            {
                "GET"    => await client.GetAsync(Form.ActionUrl),
                "DELETE" => await client.DeleteAsync(Form.ActionUrl),
                "PUT"    => await client.PutAsync(Form.ActionUrl, content),
                "PATCH"  => await client.PatchAsync(Form.ActionUrl, content),
                _        => await client.PostAsync(Form.ActionUrl, content)
            };
        }
        catch
        {
            _submitSuccess = false;
            _resultMessage = string.IsNullOrWhiteSpace(Form.ErrorMessage)
                ? "İstek sırasında bir hata oluştu."
                : Form.ErrorMessage;
            _submitting = false;
            StateHasChanged();
            return;
        }

        _submitting = false;
        _submitSuccess = response.IsSuccessStatusCode;
        _resultMessage = response.IsSuccessStatusCode
            ? (string.IsNullOrWhiteSpace(Form.SuccessMessage) ? null : Form.SuccessMessage)
            : (string.IsNullOrWhiteSpace(Form.ErrorMessage) ? "İşlem başarısız oldu." : Form.ErrorMessage);

        StateHasChanged();
    }

    private async Task NavigateBack()
        => await JS.InvokeVoidAsync("history.back");

    private static void CollectFormData(Dictionary<string, object?> data, List<BaseComponent> components)
    {
        foreach (var component in components)
        {
            if (!string.IsNullOrWhiteSpace(component.Id))
            {
                var outputProp = component.GetType()
                    .GetProperties()
                    .FirstOrDefault(p => p.GetCustomAttribute<FieldOutputPropertyAttribute>() is not null);

                if (outputProp is not null)
                    data[component.Id] = outputProp.GetValue(component);
            }

            if (component is ContainerComponent container && container.Children?.Count > 0)
                CollectFormData(data, container.Children);
        }
    }

    private async Task SelectForm()
    {
        _isSelected = true;
        if (Context.OnFieldSelected.HasDelegate)
            await Context.OnFieldSelected.InvokeAsync(Current);
    }

    private async Task OpenAddFieldDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = DialogService.ShowAsync<AddNewFieldDialog>(
            AddNewFieldDialog.DialogTitle,
            new DialogParameters { ["ExcludeContainers"] = true },
            options);

        var dialogRef = await dialog;
        var result = await dialogRef.Result;

        if (!result.Canceled)
        {
            var field = (BaseComponent)Activator.CreateInstance(result.Data.GetType())!;
            field.Id = Guid.NewGuid().ToString().Replace("-", "")[..8];
            Form.Children.Add(field);
            StateHasChanged();
        }
    }
}