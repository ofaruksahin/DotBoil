@using DotBoil.Reflection

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @foreach (var group in AvailableFields.GroupBy(f => f.Category))
            {
                <MudExpansionPanels>
                    <MudExpansionPanel Text="@group.Key">
                        <MudStack Spacing="1">
                            @foreach (var field in group)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="@Color.Default"
                                           OnClick="() => AddNewField(field)">
                                    @field.Title
                                </MudButton>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public static string DialogTitle => "Add New Field Dialog";
    
    private List<BaseComponent> BaseComponents = AppDomain.CurrentDomain.FindTypesWithBaseType(typeof(BaseComponent))
        .Where(type => !type.IsAbstract)
        .Select(baseComponent => (BaseComponent)Activator.CreateInstance(baseComponent))
        .ToList();
    
    private List<BaseComponent> DataSourceComponents = AppDomain.CurrentDomain.FindTypesWithBaseType(typeof(DataSourceComponent))
        .Where(type => !type.IsAbstract)
        .Select(baseComponent => (BaseComponent)Activator.CreateInstance(baseComponent))
        .ToList();

    private List<BaseComponent> AvailableFields =>
        BaseComponents
            .Concat(DataSourceComponents)
            .ToList();
    
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    
    private void AddNewField(BaseComponent field)
    {
        MudDialog.Close(DialogResult.Ok(field));
    }

    private void Close() => MudDialog.Cancel();
}