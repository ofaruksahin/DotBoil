@implements IDisposable
<MudNumericField T="decimal?"
                 Value="Current.Value"
                 Label="@Current.Label"
                 HelperText="@Current.HelperText"
                 Variant="Variant.Outlined"
                 Min="Current.Min"
                 Max="Current.Max"
                 Step="Current.Step" 
                 ValueChanged="value => ValueChanged(value)"/>

@code
{
    [Parameter] public NumericField Current { get; set; }
    [Parameter] public ComponentContext Context { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Current.DependsOnHandler == null)
            Current.DependsOnHandler += OnDepend;
        
        base.OnAfterRender(firstRender);
    }

    private async Task ValueChanged(decimal? value)
    {
        Current.Value = value;

        await Context.OnDepends(Current);
    }

    private async Task OnDepend(BaseComponent baseComponent, EventArgs args)
    {
    }

    public void Dispose()
    {
        if (Current.DependsOnHandler != null)
            Current.DependsOnHandler -= OnDepend;
    }
}