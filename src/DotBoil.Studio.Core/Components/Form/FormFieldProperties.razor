@inject ISnackbar Snackbar;
@if (SelectedFormField != null)
{
    @if (SelectedFormField != null)
    {
        <div Style="overflow-y: initial">
        <MudExpansionPanels Dense="true">
            @foreach (var attr in Attributes)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@attr.Value.Name</MudText>
                        <MudText Typo="Typo.caption">@attr.Value.Description</MudText>
                    </TitleContent>
                    <ChildContent>
                        @if (attr.Value.RendererType is null)
                        {
                            var propInfo = SelectedFormField.GetType().GetProperty(attr.Key);
                            var propertyType = Nullable.GetUnderlyingType(propInfo!.PropertyType) ?? propInfo.PropertyType;
                            var currentValue = propInfo?.GetValue(SelectedFormField);

                            if (NumericTypes.Contains(propertyType))
                            {
                                <MudNumericField T="decimal?"
                                                 Label="@attr.Value.Name"
                                                 Value="@(currentValue is null ? null : Convert.ToDecimal(currentValue))"
                                                 class="mb-4"
                                                 ValueChanged="@(v =>
                                                 {
                                                     if (propInfo != null && propInfo.CanWrite)
                                                     {
                                                         if (v == null)
                                                         {
                                                             propInfo.SetValue(SelectedFormField, null);
                                                         }
                                                         else
                                                         {
                                                             var converted = Convert.ChangeType(v, propertyType);
                                                             propInfo.SetValue(SelectedFormField, converted);
                                                         }
                                                     }
                                                 })"/>
                            }
                            else if (DateTypes.Contains(propertyType))
                            {
                                <MudDatePicker Date="@(currentValue as DateTime?)"
                                               Label="@attr.Value.Name"
                                               class="mb-4"
                                               DateChanged="@(v =>
                                               {
                                                   if (propInfo != null && propInfo.CanWrite)
                                                   {
                                                       propInfo.SetValue(SelectedFormField, v);
                                                   }
                                               })"/>
                            }
                            else if (BooleanTypes.Contains(propertyType))
                            {
                                <MudSwitch T="bool"
                                           Color="Color.Primary"
                                           Label="@attr.Value.Name"
                                           Value="(bool)currentValue"
                                           class="mb-4"
                                           ValueChanged="@((bool v) =>
                                           {
                                               if (propInfo != null && propInfo.CanWrite)
                                               {
                                                   propInfo.SetValue(SelectedFormField, v);
                                               }
                                           })"/>
                            }
                            else
                            {
                                <MudTextField T="string"
                                              Label="@attr.Value.Name"
                                              Value="@(currentValue?.ToString())"
                                              class="mb-4"
                                              ValueChanged="@(v =>
                                              {
                                                  if (propInfo != null && propInfo.CanWrite)
                                                  {
                                                      propInfo.SetValue(SelectedFormField, v);
                                                  }
                                              })"/>
                            }
                        }
                        else
                        {
                            var propInfo = SelectedFormField!.GetType().GetProperty(attr.Key);
                            var currentValue = propInfo?.GetValue(SelectedFormField);

                            var parameters = new Dictionary<string, object>()
                            {
                                { "CurrentComponent", SelectedFormField },
                                { "Current", currentValue }
                            };

                            if (attr.Value.RendererType == typeof(RuleSettingsRenderer))
                                parameters.Add("CurrentPropertyName", attr.Key);

                            <DynamicComponent Type="attr.Value.RendererType" Parameters="parameters"></DynamicComponent>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
        <MudStack Class="mt-4" Row="true" Justify="Justify.FlexEnd">
            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="OnDeleteClicked">
                Sil
            </MudButton>
        </MudStack>
        </div>
    }
}

@code
{
    [Parameter] public BaseComponent? SelectedFormField { get; set; }
    [Parameter] public EventCallback<BaseComponent> OnDelete { get; set; }

    private Dictionary<string, FieldPropertyAttribute> Attributes = new();
    
    private List<Type> NumericTypes = new List<Type>()
    {
        typeof(byte),
        typeof(sbyte),
        typeof(short),
        typeof(ushort),
        typeof(int),
        typeof(uint),
        typeof(long),
        typeof(ulong),
        typeof(float),
        typeof(double),
        typeof(decimal)
    };

    private List<Type> BooleanTypes = new List<Type>()
    {
        typeof(bool)
    };

    private List<Type> DateTypes = new List<Type>()
    {
        typeof(DateTime)
    };

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (SelectedFormField != null)
        {
            Attributes.Clear();

            var props = SelectedFormField.GetType()
                .GetProperties(BindingFlags.Public | BindingFlags.Instance)
                .Where(p => p.GetCustomAttribute<FieldPropertyAttribute>() != null)
                .OrderBy(prop => prop.GetCustomAttribute<FieldPropertyAttribute>().Order)
                .ToList();

            foreach (var prop in props)
            {
                var attr = prop.GetCustomAttribute<FieldPropertyAttribute>()!;
                Attributes.Add(prop.Name, attr);
            }
        }
    }

    private async Task OnDeleteClicked()
    {
        if (string.IsNullOrWhiteSpace(SelectedFormField.Id))
        {
            Snackbar.Add("Silinecek alanın Id değeri boş olamaz.", Severity.Error);
            return;
        }

        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(SelectedFormField);
        }
    }
}
