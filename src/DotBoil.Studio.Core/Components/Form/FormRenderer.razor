<MudGrid GutterSize="3">
    @foreach (var field in FormFields)
    {
        <MudItem
                 xs="@field.ColumnSpanSize.ColumnSpanXs"
                 sm="@field.ColumnSpanSize.ColumnSpanSm"
                 md="@field.ColumnSpanSize.ColumnSpanMd"
                 lg="@field.ColumnSpanSize.ColumnSpanLg"
                 xl="@field.ColumnSpanSize.ColumnSpanXl"
                 @onclick="() => OnFieldClicked(field)">
            <DynamicComponent Type="field.RendererType" Parameters="GetParameters(field)"/>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter] public List<BaseFormField> FormFields { get; set; }
    
    [Parameter] public bool DesignerMode { get; set; }

    [Parameter] public EventCallback<BaseFormField> OnFieldSelected { get; set; }

    internal BaseFormField? SelectedField { get; set; }

    private async Task OnFieldClicked(BaseFormField field)
    {
        SelectedField = field;
        if (OnFieldSelected.HasDelegate)
            await OnFieldSelected.InvokeAsync(field);
    }

    private Dictionary<string, object> GetParameters(BaseFormField baseFormField)
    {
        return new Dictionary<string, object>
        {
            { "FormField", baseFormField }
        };
    }
    
    protected override void OnInitialized()
    {
        this.DesignerMode = false;
        base.OnInitialized();
    }
}